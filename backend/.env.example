# Local HTTP server only. Vercel manages the server port automatically.
PORT=5000

# Local PostgreSQL (used when DATABASE_URL is not set)
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=product_db
PGUSER=dev_user
PGPASSWORD=dev_password

# Production: use the pooled connection string supplied by Neon/Vercel.
# Never commit a real connection string or password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Exact frontend origins allowed to call the API, separated by commas.
FRONTEND_URL=http://localhost:5173
